#!/usr/bin/env bash
# One app, one container, the cable load generator in variants, alternating (unit R4.1). Run inside colima, like bench/run:
#
#   bench/cable/ab [--app oncrack|rust|fsharp] [--clients 1000] [--reps 2] [--secs 8] [--variants "raw:2 tungstenite"] [--out DIR]
#
# A variant is "KIND[:THREADS]" (KIND raw or tungstenite) or "KIND[:THREADS]/EXTRA" for more loadgen arguments (no spaces).
# Every run is a fresh `loadgen cable` at the same client count against the same running app, so the server is as warm as it
# gets and host drift lands on every variant in turn. Prints, per run: delivered msgs/s, the load generator's and the server's
# cores busy over the saturated phase (the cgroup's cpu.stat for the server, /proc/self/stat for the load generator) and their CPU
# per delivery, and the paced p50/p99 to all clients.
set -euo pipefail
ARGS=("$@")
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
set --
export SERVER_CPUS=${SERVER_CPUS:-0-3} LOADGEN_CPUS=${LOADGEN_CPUS:-4-7}
export WORK=${WORK:-/var/tmp/campfire-bench-work}
BENCH_RUN_LIB=1 source "$ROOT/bench/run"
set -- "${ARGS[@]}"
APP=oncrack CLIENTS=1000 REPS=2 SECS=8 VARIANTS="raw:2 tungstenite" OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --app) APP=$2; shift 2 ;;
    --clients) CLIENTS=$2; shift 2 ;;
    --reps) REPS=$2; shift 2 ;;
    --secs) SECS=$2; shift 2 ;;
    --variants) VARIANTS=$2; shift 2 ;;
    --out) OUT=$2; shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
OUT=${OUT:-/var/tmp/cable-ab-$(date +%Y%m%d-%H%M%S)}
mkdir -p "$OUT"
wait_for_quiet
start_app "$APP" >/dev/null
CG=$(cgroup_dir)
sleep 3
cookie=$(lg login --base "$BASE" --email "$EMAIL" --password "$PASSWORD" | python3 -c 'import json,sys; print(json.load(sys.stdin)["cookie"])')
scrape=$(lg scrape --base "$BASE" --cookie "$cookie" --room "$ROOM")
csrf=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["csrf"] or "")' "$scrape")
streams=$(python3 -c 'import json,sys; print(",".join(json.loads(sys.argv[1])["streams"]))' "$scrape")
run_one() {
  local label=$1 variant=$2 tag=$3
  local kind=${variant%%[:/]*} threads="" extra="" rest
  rest=${variant#"$kind"}
  [[ "$rest" = :* ]] && { threads=${rest#:}; threads=${threads%%/*}; }
  [[ "$rest" = */* ]] && extra=${rest#*/}
  local pm=$OUT/$tag
  taskset -c "$PROCMEM_CPUS" python3 "$BENCH/lib/procmem.py" sample "$CG" "$pm.jsonl" & PROCMEM=$!
  local a=(--client "$kind"); [ -n "$threads" ] && a+=(--threads "$threads"); [ -n "$extra" ] && a+=(${extra//,/ })
  local res; res=$(lg cable --base "$BASE" --cookie "$cookie" --room "$ROOM" --csrf "$csrf" --streams "$streams" \
    --clients "$CLIENTS" --tput-secs "$SECS" --posters "$CABLE_POSTERS" "${a[@]}" 2> "$pm.stderr")
  sleep 0.5; kill "$PROCMEM" 2>/dev/null || true; wait "$PROCMEM" 2>/dev/null || true; PROCMEM=""
  echo "$res" > "$pm.json"
  python3 "$BENCH/lib/procmem.py" phases "$pm.jsonl" "$pm.stderr" > "$pm.phases.json"
  python3 - "$label" "$pm.json" "$pm.phases.json" <<'PY'
import json, sys
label, r, ph = sys.argv[1], json.load(open(sys.argv[2])), json.load(open(sys.argv[3]))
t, s = r["throughput"], ph["saturated"]
n = t["complete"] * r["ready"]
srv, lg = s.get("server_cpu_ms", 0), s.get("loadgen_cpu_ms", 0)
w = s.get("window_ms") or 1
lw = s.get("loadgen_window_ms") or 1
lat = r["latency"]["all_clients"]
print(f"{label:28s} ready {r['ready']:5d} failed {r['failed']}  {t['delivered_msgs_per_sec']:8.1f} msgs/s  server {srv / w:4.2f} cores {srv * 1000 / max(n, 1):5.2f} us/del"
      f"  loadgen {lg / lw:4.2f} cores {lg * 1000 / max(n, 1):5.2f} us/del  paced p50 {lat.get('p50_ms')} p99 {lat.get('p99_ms')}  sat p99 {t['all_clients'].get('p99_ms')}")
PY
}
# One short run first, so the JIT and the pools are warm for the measured ones.
run_one warm raw:2 warm >/dev/null || true
for rep in $(seq 1 "$REPS"); do
  for v in $VARIANTS; do run_one "$APP $CLIENTS $v #$rep" "$v" "$APP-$CLIENTS-${v//[:\/]/_}-$rep"; sleep 3; done
done
docker rm -f "$CONTAINER" >/dev/null; rm -rf "${WORK:?}/${APP:?}"
echo "-> $OUT"
