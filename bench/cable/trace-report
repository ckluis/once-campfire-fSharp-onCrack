#!/usr/bin/env python3
"""Unit R5.1: reads one loop phase's evidence (bench/cable/loop's DIR/runNN-cCLIENTS/) and says, for each message some client lacks,
which side lost it.

  bench/cable/trace-report PHASE_DIR [--json] [--max-seqs 10]

PHASE_DIR holds client/ (the load generator's dumps: LABEL-summary.json and LABEL-wN.jsonl, written on the first window stall and on a
drain timeout, or at the end with `--trace-always 1`) and server-trace.jsonl (the app's CAMPFIRE_CABLE_TRACE lines for the phase:
G groups, P publishes with the marker number of the message in the frame, C one per connection). A client is matched to its server
connection by port: the load generator's local port is the server's remote port.

For each incomplete message and each client that lacks it the verdict is one of:
  NOT_PUBLISHED       no publish record has this marker: the server never put it in a log (or the trace lost it)
  NOT_SUBSCRIBED      the client's connection was not subscribed to the group the message was published to
  SKIPPED_BY_SERVER   published to a group the connection is subscribed to, and never handed to one of its writes
  SENT_NOT_COUNTED    handed to one of the connection's writes: the bytes went to the socket, so the client read it past or lost it
  NO_SERVER_CONN      no server connection with the client's port in the trace
Also: for every client in the dump, the messages the server handed to its writes against the messages the client counted.
"""
import bisect
import collections
import glob
import json
import os
import sys


def lines(path):
    out = []
    with open(path) as f:
        for ln in f:
            ln = ln.strip()
            if ln:
                try:
                    out.append(json.loads(ln))
                except ValueError:
                    pass
    return out


def load_server(path):
    groups, pubs, conns = {}, collections.defaultdict(list), []
    for e in lines(path):
        t = e.get("t")
        if t == "G":
            groups[e["g"]] = e
        elif t == "P":
            if e["m"] >= 0:
                pubs[e["m"]].append(e)
        elif t == "C":
            conns.append(e)
    by_port = {}
    for c in conns:
        port = c["remote"].rsplit(":", 1)[-1]
        by_port.setdefault(port, []).append(c)
    return groups, pubs, conns, by_port


class Runs:
    """A connection's handed publish numbers, as sorted runs (first, count)."""

    def __init__(self, runs):
        self.firsts = [r[0] for r in runs]
        self.runs = runs

    def has(self, s):
        i = bisect.bisect_right(self.firsts, s) - 1
        return i >= 0 and self.runs[i][0] <= s < self.runs[i][0] + self.runs[i][1]

    def around(self, s):
        i = bisect.bisect_right(self.firsts, s) - 1
        near = [self.runs[j] for j in range(max(0, i - 1), min(len(self.runs), i + 2))]
        return near


def report(phase, max_seqs):
    cdir = os.path.join(phase, "client")
    out = {"phase": phase, "labels": {}}
    spath = os.path.join(phase, "server-trace.jsonl")
    have_server = os.path.exists(spath) and os.path.getsize(spath) > 0
    groups, pubs, conns, by_port = load_server(spath) if have_server else ({}, {}, [], {})
    out["server_trace"] = {"present": have_server, "groups": len(groups), "marked_publishes": sum(len(v) for v in pubs.values()), "connections": len(conns)}
    for sp in sorted(glob.glob(os.path.join(cdir, "*-summary.json"))):
        label = os.path.basename(sp)[: -len("-summary.json")]
        summary = json.load(open(sp))
        clients = []
        for wp in sorted(glob.glob(os.path.join(cdir, f"{label}-w*.jsonl"))):
            clients += lines(wp)
        L = {"summary": {k: summary[k] for k in ("clients", "expected", "incomplete", "unix_ms", "start_unix_ms")}, "messages": []}
        open_clients = [c for c in clients if not c.get("closed")]
        closed_clients = [c for c in clients if c.get("closed")]
        L["clients_in_dump"] = len(open_clients)
        L["clients_closed_before_dump"] = [{k: c.get(k) for k in ("local_port", "closed_ns", "confirmed", "frames", "last_seq")} for c in closed_clients]
        tallies = collections.Counter()
        for m in summary["first_incomplete"][:max_seqs]:
            seq = m["seq"]
            entry = {"seq": seq, "received_by": m["received_by"], "sent_unix_ms": m.get("sent_unix_ms"), "last_receipt_unix_ms": m.get("last_receipt_unix_ms")}
            pub = pubs.get(seq, [])
            entry["published"] = [{"group": p["g"], "hub_seq": p["s"], "ordinal": p["o"], "ms": p["ms"], "group_name": groups.get(p["g"], {}).get("name")} for p in pub]
            lacking = [c for c in open_clients if seq in (c.get("missing") or []) or (c.get("missing_n", 0) > 200 and not c.get("missing"))]
            entry["clients_lacking"] = len(lacking)
            verdicts = collections.Counter()
            detail = []
            for c in lacking:
                port = str(c["local_port"])
                sc = by_port.get(port)
                v, info = None, {}
                if not have_server:
                    v = "NO_SERVER_TRACE"
                elif not pub:
                    v = "NOT_PUBLISHED"
                elif not sc:
                    v = "NO_SERVER_CONN"
                else:
                    sc = sc[-1]
                    runs = Runs([tuple(r) for r in sc["runs"]])
                    subs = {s["g"] for s in sc["subs"]}
                    mine = [p for p in pub if p["g"] in subs]
                    if not mine:
                        v = "NOT_SUBSCRIBED"
                        info["subscribed_groups"] = sorted(subs)
                    else:
                        p = mine[0]
                        info["hub_seq"] = p["s"]
                        if runs.has(p["s"]):
                            v = "SENT_NOT_COUNTED"
                        else:
                            v = "SKIPPED_BY_SERVER"
                            info["runs_around"] = runs.around(p["s"])
                            info["events_near_publish"] = [e for e in sc["events"] if abs(e[0] - p["ms"]) <= 3000]
                    info["server_conn"] = {k: sc[k] for k in ("id", "frames_called", "frames_done", "non_monotone", "crossings", "reason")}
                    info["server_conn"]["writes"] = sc["writes"]
                    info["server_conn"]["event_codes"] = dict(collections.Counter(e[1] for e in sc["events"]))
                verdicts[v] += 1
                tallies[v] += 1
                if len(detail) < 5:
                    detail.append({"client": {k: c.get(k) for k in ("slot", "local_port", "frames", "text_frames", "receipts", "last_seq", "last_msg_ns", "missing_n")}, "verdict": v, **info,
                                   "client_recent_frames": c.get("recent", [])[-12:], "client_suspects": c.get("suspects", [])})
            entry["verdicts"] = dict(verdicts)
            entry["examples"] = detail
            L["messages"].append(entry)
        L["verdict_totals"] = dict(tallies)
        # Every client: the marked messages the server handed to its writes against the messages the client counted.
        if have_server and clients:
            exp = set()
            rec = []
            for c in open_clients:
                sc = by_port.get(str(c["local_port"]))
                if not sc:
                    rec.append(("no-server-conn", c, None))
                    continue
                sc = sc[-1]
                runs = Runs([tuple(r) for r in sc["runs"]])
                subs = {s["g"] for s in sc["subs"]}
                handed = 0
                total = 0
                for seq, ps in pubs.items():
                    for p in ps:
                        if p["g"] in subs:
                            total += 1
                            if runs.has(p["s"]):
                                handed += 1
                rec.append(("ok", c, (handed, total, sc)))
            equal = sum(1 for k, c, x in rec if k == "ok" and x[0] == c["receipts"])
            differ = [(c["local_port"], x[0], c["receipts"], x[1]) for k, c, x in rec if k == "ok" and x[0] != c["receipts"]]
            L["reconcile"] = {"clients": len(open_clients), "no_server_conn": sum(1 for k, _, _ in rec if k == "no-server-conn"), "handed_equals_counted": equal,
                              "differ_examples(port, handed_by_server, counted_by_client, published_to_its_groups)": differ[:10], "differ": len(differ)}
        out["labels"][label] = L
    return out


def text(out):
    s = [f"# {out['phase']}", f"server trace: {out['server_trace']}"]
    for label, L in out["labels"].items():
        s.append(f"\n## dump `{label}`: {L['summary']['incomplete']} of {L['summary']['expected']} messages incomplete, {L['clients_in_dump']} clients in the dump")
        if L["clients_closed_before_dump"]:
            s.append(f"clients closed before the dump: {L['clients_closed_before_dump']}")
        s.append(f"verdicts: {L['verdict_totals']}")
        for m in L["messages"]:
            s.append(f"- message {m['seq']}: received by {m['received_by']}; published {m['published'] or 'NO RECORD'}; {m['clients_lacking']} clients lack it: {m['verdicts']}")
            for e in m["examples"][:2]:
                s.append(f"    port {e['client']['local_port']}: {e['verdict']}" + (f" hub_seq {e.get('hub_seq')}" if e.get('hub_seq') else "") +
                         f" client frames {e['client']['frames']} receipts {e['client']['receipts']} last_seq {e['client']['last_seq']}")
        if "reconcile" in L:
            s.append(f"reconcile (server handed vs client counted): {json.dumps(L['reconcile'])}")
    return "\n".join(s)


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a:
        print(__doc__)
        sys.exit(2)
    mx = 10
    if "--max-seqs" in a:
        mx = int(a[a.index("--max-seqs") + 1])
    out = report(a[0], mx)
    print(json.dumps(out, indent=1) if "--json" in a else text(out))
