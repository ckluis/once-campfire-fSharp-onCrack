<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tier 1 for the post path (onCrack unit R2.2): the whole app in this process, served by its own front server on loopback over a
       copy of a parity seed, and N keep-alive connections posting messages into a room. It alternates windows between variants of
       the app's runtime switches (`PostPath`) in one warm process and prints posts/s, process CPU and bytes allocated per post. The
       clients run in the same process, so CPU per post includes theirs (a fixed few microseconds); compare variants, never report
       its numbers as results. Not in the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Campfire.App/Campfire.App.fsproj" />
  </ItemGroup>
</Project>
