#!/usr/bin/env bash
# onCrack's before/after runner (plans/oncrack.md; Phase 7's tuning loop, kept). Run inside colima, like bench/run:
#
#   bench/quick [--reps 3] [--apps oncrack] [--remeasure-rust] [--mounted DIR] [--only APP:REP] [--out DIR] [--secs 8] [--warmup 30] [--warmup-max 90] [--concs "1 16"] [--routes a,b] [--part K/N]
#   bench/quick --real [--real-concs "16"] ...         # the realistic workloads instead of the five (unit R2.0, below)
#   bench/quick compare DIR                           # onCrack in DIR against the stored Rust and F# port medians (bench/results/phase7-final)
#   bench/quick log DIR --unit readcache --tier 2 --change "..." --kept true|false [--build mounted]   # append to oncrack-log.jsonl, rebuild index.html
#   bench/quick report DIR                            # bench/report again, on any bench/run or bench/quick directory
#   bench/quick cpu [--reps 1] [--secs 6] [--warmup 30] [--out DIR]   # CPU per request only (bench/breakdown cpu on the five workloads)
#
# onCrack ONLY BY DEFAULT: Rust and the F# port are fixed targets, so a run measures onCrack alone (image campfire-oncrack:app, run exactly as
# the F# port is) and bench/quick compare prints it against the stored medians of bench/results/phase7-final/, where Rust and the port were
# measured in one session: "vs stored Rust baseline" and "vs stored F# port baseline". --apps takes any of reference, rust, fsharp (the port,
# campfire-fsharp:app, untouched) and oncrack, in one session, as bench/run does; --remeasure-rust adds Rust (oncrack,rust), for a re-baseline
# that closes a phase. --mounted DIR is the tier 2 build: DIR, published by bin/publish-mounted, is mounted over /opt/campfire in
# campfire-oncrack:app (ONCRACK_MOUNT; FSHARP_MOUNT when the apps are the port alone), so there is no image rebuild; same env, seed copy, pinning and warm-up.
#
# The default is bench/run restricted to what a tuning unit needs: the five workloads (room page, messages page,
# sidebar, search, post a message) at c=1 and c=16, the HTTP suite only (no Cable, upload or extra concurrencies),
# 3 reps (with two or more apps the order alternates: rust, oncrack, then oncrack, rust, ...), a fresh container and seed copy per app
# and rep, the same warm-up (WARMUP_SECS at each route and concurrency), the same pinning (SERVER_CPUS=0-3,
# LOADGEN_CPUS=4-7), and the same validity checks and report as bench/run: the status of every response, rows written
# against posts, response bytes per route, load average before each run, a host-noise probe (bench/lib/hostprobe.py: a run
# starts only when the pinned CPUs run a fixed spin at their quiet speed, and every window is probed after), and the container's CPU per request
# (cgroup cpu.stat, unprofiled) next to each throughput. The result directory defaults to bench/results/quick-<stamp>.
#
# Time: each (route, c) costs its warm-up (at least WARMUP_SECS = 30 s, until the app is flat, at most WARMUP_MAX_SECS = 90: the
# CLR's JIT stops at 30-45 s), a probe of the host, and --secs 8, so one app-rep is about 10 x (30 + 8 + 3) s = 8-10 minutes, plus
# start-up and the wait for the host to be quiet; 3 reps of onCrack alone are about half an hour, which does not fit one foreground call.
# Run it a rep at a time (two parts each), the schedule staying the same:
#   bench/quick --only oncrack:1 --part 1/2 --out DIR; bench/quick --only oncrack:1 --part 2/2 --out DIR
#   ... then oncrack:2 and oncrack:3 (two parts each); bench/quick report DIR; bench/quick compare DIR
# `--reps 1 --secs 5 --warmup 10 --warmup-max 10` is the 4-minute smoke version (a fixed 10 s warm-up, one rep): the
# plumbing check, not a number to compare with a full run.
#
# One app-rep can take longer than a foreground call allows (up to 10 x (90 + 8 + 3) s when the JIT is slow to settle):
# --part K/N runs the Kth of N slices of the route list (in a fresh container, merged into the rep's file), so the unit
# is `--only oncrack:1 --part 1/2` then `--only oncrack:1 --part 2/2`; the report treats the two as one rep.
#
# Same seed (a copy of parity/.seed/default per app and rep), same images: ONCRACK_IMAGE, FSHARP_IMAGE and RUST_IMAGE as in bench/run.
#
# --real runs the realistic workloads (bench/lib/realistic.py; unit R2.0, bench/results/oncrack-r2-bench.md) instead of the five: `mixed`
# (c connections read the busy room while one posts into it), `spread` (c connections over every signed-in user's room pages and
# sidebar, 525 users of the crowd seed), `spread_mixed` (spread plus one connection posting as 31 users into their rooms) and
# `search_spread` (c connections over 525 users x 200 queries), at --real-concs (default 16) reading connections, on a copy of the crowd
# seed, in a container of their own (so with --part, run them as a part of their own, or as a run of their own). bench/quick compare
# prints them against the same-session baseline of bench/results/oncrack-r2-bench/ (Rails, Rust, the F# port and onCrack), reads/s
# and posts/s apart. One app-rep of the four is about 5-7 minutes (the 525 sign-ins take 30-60 s of it).
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export SERVER_CPUS=${SERVER_CPUS:-0-3} LOADGEN_CPUS=${LOADGEN_CPUS:-4-7}
export WORK=${WORK:-/var/tmp/campfire-bench-work}

if [ "${1:-}" = report ]; then shift; exec "$ROOT/bench/report" "$@"; fi
if [ "${1:-}" = compare ]; then shift; exec python3 "$ROOT/bench/lib/quicklog.py" compare "$@"; fi
if [ "${1:-}" = log ]; then shift; exec python3 "$ROOT/bench/lib/quicklog.py" log "$@"; fi
MODE=run
if [ "${1:-}" = cpu ]; then MODE=cpu; shift; fi

MOUNTED="" APPS=oncrack REPS=3 OUT="" ONLY="" SECS="" WARMUP="" WARMUP_MAX="" PART="" CONCS="1 16" ROUTES="room_show,messages_page,sidebar,search,post_message" REAL_CONCS=16
[ "$MODE" = cpu ] && REPS=1
while [ $# -gt 0 ]; do
  case "$1" in
    --reps) REPS=$2; shift 2 ;;
    --apps) APPS=$2; shift 2 ;;
    --remeasure-rust) APPS=rust,oncrack; shift ;;
    --mounted) MOUNTED=$2; shift 2 ;;
    --only) ONLY=$2; shift 2 ;;
    --out) OUT=$2; shift 2 ;;
    --secs) SECS=$2; shift 2 ;;
    --warmup) WARMUP=$2; shift 2 ;;
    --warmup-max) WARMUP_MAX=$2; shift 2 ;;
    --concs) CONCS=$2; shift 2 ;;
    --routes) ROUTES=$2; shift 2 ;;
    --real) ROUTES=mixed,spread,spread_mixed,search_spread; shift ;;
    --real-concs) REAL_CONCS=$2; shift 2 ;;
    --part) PART=$2; shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done
# The mounted build goes over the app the run measures: onCrack's image when onCrack is among the apps, else the port's.
if [ -n "$MOUNTED" ]; then
  case ",$APPS," in *,oncrack,*) export ONCRACK_MOUNT=$MOUNTED ;; *) export FSHARP_MOUNT=$MOUNTED ;; esac
fi
OUT=${OUT:-$ROOT/bench/results/quick-$(date +%Y%m%d-%H%M%S)}
[ -z "$WARMUP" ] || export WARMUP_SECS=$WARMUP
[ -z "$WARMUP_MAX" ] || export WARMUP_MAX_SECS=$WARMUP_MAX

export SCHEDULE_ROUTES="${ROUTES//,/ }${PART:+ (in parts, --part $PART is one slice of them)}"
if [ -n "$PART" ]; then
  # The Kth of N slices of the route list: the first ceil(len/N) routes are part 1, and so on.
  ROUTES=$(python3 - "$ROUTES" "$PART" <<'PY'
import math, sys
routes, (k, n) = sys.argv[1].split(","), map(int, sys.argv[2].split("/"))
size = math.ceil(len(routes) / n)
print(",".join(routes[(k - 1) * size:k * size]))
PY
)
  export MERGE_PART=1
  [ "${PART%/*}" != 1 ] || rm -f "$OUT/${ONLY/:/-}.json"   # part 1 starts the rep's file afresh
fi
case "$MODE" in
  run)
    export SUITES=http HTTP_CONCS="$CONCS" REAL_CONCS="$REAL_CONCS" HTTP_ROUTES="${ROUTES//,/ }" HTTP_SECS=${SECS:-8} IDLE_SECS=${IDLE_SECS:-5}
    only=(); [ -z "$ONLY" ] || only=(--only "$ONLY")
    "$ROOT/bench/run" --apps "$APPS" --reps "$REPS" --out "$OUT" "${only[@]}"
    case ",$APPS," in *,oncrack,*) python3 "$ROOT/bench/lib/quicklog.py" compare "$OUT" | tee "$OUT/vs-stored.md" ;; esac
    ;;
  cpu)
    # bench/breakdown cpu runs each route at c=1 and c=16 (warm-up first) and prints the table that bench/breakdown report makes.
    "$ROOT/bench/breakdown" cpu --apps "$APPS" --reps "$REPS" --routes "$ROUTES" --secs "${SECS:-6}" --out "$OUT"
    "$ROOT/bench/breakdown" report "$OUT" | tee "$OUT/report.md"
    ;;
esac
