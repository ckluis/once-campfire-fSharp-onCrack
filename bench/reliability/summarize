#!/usr/bin/env python3
"""Unit R4.5: the reliability table of one or more bench/reliability/run output directories (medians over rounds).

  bench/reliability/summarize DIR [DIR ...]  [--md]

Per app and profile (cable: 4 posters, cable_heavy: 64 closed-loop posters, no window): clients subscribed, disconnected (connections the
server closed mid-run; absent in the harness's JSON when none), messages delivered to every client over posted, delivered messages a
second, the p99 of a post to the last client, refused posts, the drain time after posting, and the peak app Pss in the profile's window
(memory.jsonl, from sampler.py, when the directory has one). Directories are read in order and a row repeated in a later one replaces the earlier
(`label=DIR` names a run's rows: `onCrack before=bench/results/.../before`).
"""
import glob, json, os, re, statistics, sys


def rows_of(d):
    rows = []
    for f in sorted(glob.glob(os.path.join(d, "harness-output", "*-[0-9].json"))):
        rows.append(json.load(open(f)))
    return rows


def windows(d):
    """(app, round, profile) -> (start, end) epoch seconds, from the timestamps run.log puts on the harness's progress lines."""
    out, prev = {}, None
    p = os.path.join(d, "run.log")
    if not os.path.exists(p):
        return out
    for line in open(p):
        m = re.match(r"(\d+) (\S+?)(?: round (\d+))?: (overload|cable_heavy|cable)\b", line)
        if not m:
            continue
        t, app, rnd, prof = int(m.group(1)), m.group(2), m.group(3), m.group(4)
        if prof == "overload":
            prev = t
            continue
        out[(app, int(rnd), prof)] = (prev if prev is not None else t - 120, t)
        prev = t
    return out


def peaks(d, win):
    p = os.path.join(d, "memory.jsonl")
    res = {}
    if not os.path.exists(p):
        return res
    samples = [json.loads(x) for x in open(p) if x.strip()]
    for key, (a, b) in win.items():
        inside = [s for s in samples if a < s["t"] <= b + 1]
        if inside:
            res[key] = max(s["pss_mb"] for s in inside)
    return res


def collect(label, d):
    win = windows(d)
    pk = peaks(d, win)
    table = {}
    for row in rows_of(d):
        for prof in ("cable", "cable_heavy"):
            r = row.get(prof)
            if not r:
                continue
            t = r["throughput"]
            table.setdefault((label or row["app"], prof), []).append({
                "app": row["app"], "round": row["round"], "ready": r["ready"], "clients": r["clients"], "disconnected": r.get("disconnected", 0),
                "posted": t["posted"], "complete": t["complete"], "msgs": t["delivered_msgs_per_sec"], "p99": t["all_clients"]["p99_ms"],
                "attempts": t["post_attempts"], "errors": t["post_errors"], "drain": t["drain_secs"], "posters": t["posters"],
                "pss": pk.get((row["app"], row["round"], prof))})
    return table


def med(xs):
    xs = [x for x in xs if x is not None]
    return statistics.median(xs) if xs else None


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    table = {}
    for a in args:
        label, _, d = a.partition("=") if "=" in a else ("", "", a)
        table.update(collect(label, d))
    print("| app | profile | posters | subscribed | disconnected | delivered to all | msgs/s | p99 ms | refused posts | drain s | peak Pss MB |")
    print("|---|---|---|---|---|---|---|---|---|---|---|")
    for (app, prof), rs in table.items():
        f = lambda v, n=1: "-" if v is None else format(round(v, n), ",")
        print("| %s | %s | %d | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            app, prof, rs[0]["posters"], "/".join("%d" % r["ready"] for r in rs), "/".join("%d" % r["disconnected"] for r in rs),
            ", ".join("%d/%d" % (r["complete"], r["posted"]) for r in rs), f(med([r["msgs"] for r in rs])), f(med([r["p99"] for r in rs])),
            "/".join("%d" % r["errors"] for r in rs), f(med([r["drain"] for r in rs]), 2), f(med([r["pss"] for r in rs]), 0)))


main()
