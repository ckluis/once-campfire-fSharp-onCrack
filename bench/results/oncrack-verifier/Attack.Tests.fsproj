<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);FS3390;FS1182;FS3370</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="/Users/clank/Desktop/projects/once-campfire-fsharp-oncrack/tests/Shared/Repo.fs" Link="Repo.fs" />
    <Compile Include="/Users/clank/Desktop/projects/once-campfire-fsharp-oncrack/tests/Campfire.App.Tests/Support.fs" Link="Support.fs" />
    <Compile Include="AttackTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="/Users/clank/Desktop/projects/once-campfire-fsharp-oncrack/src/Campfire.App/Campfire.App.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="xunit.v3" Version="3.2.0" />
  </ItemGroup>
</Project>
