#!/usr/bin/env bash
# Tier 2 build for Phase 7's tuning loop: publish the onCrack app exactly as the Dockerfile does (Release, self-contained,
# ReadyToRun, linux-arm64, no symbols) into DIR on the colima VM's own disk, without rebuilding the image. bench/quick
# --mounted DIR then runs it in a container of campfire-oncrack:app with DIR mounted over /opt/campfire.
#
#   colima ssh -- bash -c "cd $PWD && bin/publish-mounted [DIR]"
#
# It builds in the toolchain image (the SDK global.json pins, Linux) from an rsync copy of src/ kept in
# /var/tmp/campfire-publish-src, so the second build is incremental and neither the virtiofs mount nor the Mac's own
# obj/ directories are involved (the Mac's `dotnet publish -r linux-arm64` fails restoring Campfire.Assets.Build's osx apphost).
# AOT=1 publishes with Native AOT instead (onCrack C4; needs clang, so it runs in campfire-aot-toolchain:latest, the toolchain image plus clang
# and zlib1g-dev, built by `bin/publish-mounted aot-toolchain`); PUBLISH_ARGS adds MSBuild properties (-p:Name=Value ...) to the publish.
# DIR defaults to /var/tmp/campfire-mounted. Prints the published directory and the commit it was built from.
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DIR=${1:-/var/tmp/campfire-mounted}
SRC=${PUBLISH_SRC:-/var/tmp/campfire-publish-src}
IMAGE=${TOOLCHAIN_IMAGE:-campfire-fsharp-toolchain:latest}
if [ "${1:-}" = aot-toolchain ]; then
  printf 'FROM campfire-fsharp-toolchain:latest\nRUN apt-get update -qq && apt-get install --no-install-recommends -y clang lld zlib1g-dev >/dev/null && rm -rf /var/lib/apt/lists\n' | docker build -q -t campfire-aot-toolchain:latest -
  exit 0
fi
R2R=true AOTARGS=""
if [ -n "${AOT:-}" ]; then IMAGE=${TOOLCHAIN_IMAGE:-campfire-aot-toolchain:latest}; R2R=false; AOTARGS="-p:PublishAot=true"; fi
case "$(uname -m)" in aarch64|arm64) rid=linux-arm64 ;; x86_64) rid=linux-x64 ;; *) echo "unsupported architecture" >&2; exit 1 ;; esac

mkdir -p "$SRC/src" "$DIR"
rsync -a --delete --exclude bin/ --exclude obj/ "$ROOT/src/" "$SRC/src/"
cp "$ROOT/global.json" "$ROOT/Directory.Build.props" "$ROOT/Directory.Packages.props" "$SRC/"
docker run --rm -v "$SRC:/src" -v "$ROOT/reference:/src/reference:ro" -v campfire-fsharp-nuget:/root/.nuget/packages \
  -e DOTNET_NOLOGO=1 -e DOTNET_CLI_TELEMETRY_OPTOUT=1 -w /src "$IMAGE" bash -c "
    set -e
    rm -rf /src/out
    dotnet build src/Campfire.Assets.Build/Campfire.Assets.Build.fsproj -c Release -v quiet -nologo
    dotnet publish src/Campfire.App/Campfire.App.fsproj -c Release -r $rid --self-contained true \
      -p:PublishReadyToRun=$R2R $AOTARGS ${PUBLISH_ARGS:-} -p:DebugType=None -p:DebugSymbols=false -o /src/out -v quiet -nologo
    chmod -R a+rwX /src/out"
rsync -a --delete "$SRC/out/" "$DIR/"
echo "$(git -C "$ROOT" rev-parse --short HEAD) (dirty files under src/: $(git -C "$ROOT" status --porcelain -- src | wc -l)) at $(date -u +%FT%TZ)" > "$DIR/.built-from"
git -C "$ROOT" rev-parse --short HEAD > "$DIR/REVISION"  # bench/lib/quicklog.py logs runs against the commit the build came from
echo "published $(ls "$DIR" | wc -l) files to $DIR from $(git -C "$ROOT" rev-parse --short HEAD) (dirty files under src/: $(git -C "$ROOT" status --porcelain -- src | wc -l))"
